
import streamlit as st
import requests
import pandas as pd

st.set_page_config(
    page_title="Delta Reversal Scanner",
    layout="wide"
)

st.title("🔥 Delta Reversal Scanner")
st.caption("Live market-data scanner")

BASE_URL = "https://api.india.delta.exchange"

@st.cache_data(ttl=30)
def get_products():
    url = BASE_URL + "/v2/products"
    response = requests.get(url, timeout=10)
    response.raise_for_status()

    data = response.json()

    products = []

    for p in data.get("result", []):
        if (
            p.get("contract_type") == "perpetual_futures"
            and p.get("state") == "live"
            and p.get("trading_status") == "operational"
        ):
            products.append({
                "symbol": p.get("symbol"),
                "underlying": p.get(
                    "underlying_asset", {}
                ).get("symbol")
            })

    return products


try:
    products = get_products()

    st.success(
        f"Delta connected — {len(products)} live perpetual contracts found"
    )

    df = pd.DataFrame(products)

    st.dataframe(
        df,
        use_container_width=True,
        hide_index=True
    )

except Exception as e:
    st.error(f"Error: {e}")
